# Rename to ".env" and fill in your own MQTT details.

# MQTT Configuration
MQTT_BROKER=your.mqtt.broker.address
MQTT_PORT=8883
MQTT_CA_CERT=./certs/ca.crt
MQTT_USERNAME=your_mqtt_username
MQTT_PASSWORD=your_mqtt_password

# Database for registered clients
DB_PATH=notification.db
SQLALCHEMY_DATABASE_URL=sqlite:///./notification.db

# Apple Push Notification service (APNs) — for iOS device delivery.
# Leave empty to disable APNs delivery (the server still works for MQTT clients).
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PATH=./certs/AuthKey_XXXXXXXXXX.p8
APNS_TOPIC=com.pingberry.ios
APNS_USE_SANDBOX=true
